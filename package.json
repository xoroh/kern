{
  "name": "kern",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.3.8"
  },
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter @xoroh/kern typecheck",
    "test": "bun run --filter @xoroh/kern test",
    "build": "bun run --filter @xoroh/kern build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "culori": "^4.0.2",
    "typescript": "6"
  }
}
