{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kern.xoroh.org/contracts/1.0.0/schema.json",
  "title": "Kern contracts 1.0.0",
  "description": "Platform-free metadata records for the Kern design system (ADR-P02).",
  "type": "object",
  "properties": {
    "provider": {
      "type": "object",
      "required": ["id", "label", "specGeneration", "evidence"],
      "properties": {
        "id": { "const": "m3" },
        "label": { "type": "string", "minLength": 1 },
        "specGeneration": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "schemaVersion",
        "provider",
        "renderer",
        "name",
        "export",
        "entrypoint",
        "path",
        "status",
        "origin",
        "capabilities"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "provider": { "const": "m3" },
        "renderer": { "enum": ["web", "native"] },
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "export": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "entrypoint": { "enum": [".", "./start", "./native"] },
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["real", "stub"] },
        "axes": { "type": "array", "items": { "type": "string" } },
        "origin": { "enum": ["spec-native", "kern-adaptation"] },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "enum": ["verified", "unverified", "unsupported"]
          }
        },
        "obligations": { "type": "array", "items": { "type": "string" } },
        "platformException": { "type": "string" },
        "dependencies": {
          "type": "object",
          "properties": {
            "tokens": { "type": "array", "items": { "type": "string" } },
            "icons": { "type": "array", "items": { "type": "string" } },
            "files": { "type": "array", "items": { "type": "string" } },
            "npm": { "type": "array", "items": { "type": "string" } },
            "assets": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "doc": { "type": "string" },
        "example": { "type": "string" },
        "installModes": {
          "type": "array",
          "items": { "enum": ["package", "source-hybrid", "source-snapshot"] }
        },
        "compatibility": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
