{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kern.xoroh.org/contracts/1.0.0/schema.json",
  "title": "Kern contracts 1.0.0",
  "description": "Platform-free metadata records for the Kern design system (ADR-P02).",
  "type": "object",
  "properties": {
    "component": {
      "type": "object",
      "required": [
        "schemaVersion",
        "designSystem",
        "renderer",
        "name",
        "export",
        "entrypoint",
        "path",
        "status",
        "origin",
        "capabilities"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "designSystem": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "renderer": {
          "enum": ["web", "native"]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "entrypoint": {
          "enum": [".", "./start", "./native"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["real", "stub"]
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "enum": ["spec-native", "kern-adaptation"]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "enum": ["verified", "unverified", "unsupported"]
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platformException": {
          "type": "string"
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "icons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "npm": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:web|native)/[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "additionalProperties": false
        },
        "replaces": {
          "type": "string",
          "pattern": "^(?:web|native)/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "doc": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "installModes": {
          "type": "array",
          "items": {
            "enum": ["package", "source-hybrid", "source-snapshot"]
          }
        },
        "compatibility": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "schemaVersion",
        "designSystem",
        "name",
        "title",
        "description",
        "category",
        "platforms",
        "components",
        "installCommand",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "designSystem": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["web", "native"]
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "installCommand": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "icon": {
      "type": "object",
      "required": [
        "schemaVersion",
        "name",
        "glyph",
        "meaning",
        "sizes",
        "fill",
        "decorative"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "glyph": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "fill": {
          "type": "boolean"
        },
        "decorative": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "schemaVersion",
        "releaseSet",
        "mode",
        "files",
        "assets",
        "licenses",
        "config"
      ],
      "properties": {
        "schemaVersion": {
          "const": "2"
        },
        "releaseSet": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["package", "source-hybrid", "source-snapshot"]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "baselineHash",
              "currentHash",
              "owner",
              "customized"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "baselineHash": {
                "type": "string",
                "minLength": 1
              },
              "currentHash": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "customized": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": ["target", "renderer", "mode"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "renderer": {
          "enum": ["web", "native", "both"]
        },
        "mode": {
          "enum": ["package", "source-hybrid", "source-snapshot"]
        },
        "preset": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "pm": {
          "enum": ["bun", "npm", "pnpm", "yarn"]
        }
      },
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "required": [
        "schemaVersion",
        "category",
        "title",
        "description",
        "consent"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "category": {
          "enum": ["bug", "improvement", "docs", "compatibility", "discovery"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "component": {
          "type": "string"
        },
        "block": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "renderer": {
          "enum": ["web", "native", "both"]
        },
        "framework": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "packageVersion": {
          "type": "string"
        },
        "cliVersion": {
          "type": "string"
        },
        "steps": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "maxLength": 8000
        },
        "consent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
