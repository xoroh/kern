{
  "name": "@xoroh/kern-contracts",
  "version": "0.0.0",
  "description": "Kern contract schema: versioned platform-free metadata types and validators for providers, components, blocks, icons, and installs.",
  "license": "MIT",
  "author": "Xoroh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoroh/kern.git",
    "directory": "packages/kern-contracts"
  },
  "homepage": "https://kern.xoroh.org",
  "bugs": "https://github.com/xoroh/kern/issues",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --dts-resolve --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:publish": "publint && attw --pack --ignore-rules=no-resolution"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema.json": "./src/schema.json"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
