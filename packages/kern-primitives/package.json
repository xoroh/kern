{
  "name": "@xoroh/kern-primitives",
  "version": "0.0.0",
  "description": "The un-styled behaviour kernel shared by the Kern web and native renderers.",
  "license": "MIT",
  "author": "Xoroh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoroh/kern.git",
    "directory": "packages/kern-primitives"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --dts-resolve --external react --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers 4",
    "check:publish": "publint && attw --pack --ignore-rules=no-resolution"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "attw": "^0.12.0",
    "publint": "^0.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
