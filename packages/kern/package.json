{
  "name": "@xoroh/kern",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "Xoroh",
  "repository": {
    "type": "git",
    "url": "https://github.com/xoroh/kern.git",
    "directory": "packages/kern"
  },
  "homepage": "https://kern.xoroh.org",
  "bugs": "https://github.com/xoroh/kern/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/theme/tokens.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react-native/index.ts src/theme/tokens.ts src/utils/cn.ts --format esm,cjs --external react --external react-native --external /^@base-ui\\// --out-dir dist --clean && tsc -p tsconfig.build.json",
    "test": "vitest run --maxWorkers 4",
    "test:native": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    },
    "./native": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js",
      "default": "./dist/react-native/index.cjs"
    },
    "./theme": "./src/theme/tokens.css",
    "./tokens": {
      "types": "./dist/theme/tokens.d.ts",
      "import": "./dist/theme/tokens.js",
      "default": "./dist/theme/tokens.cjs"
    },
    "./utils": {
      "types": "./dist/utils/cn.d.ts",
      "import": "./dist/utils/cn.js",
      "default": "./dist/utils/cn.cjs"
    }
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-native": "^0.87.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.5",
    "@react-native/babel-preset": "^0.87.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-test-renderer": "^19.3.0",
    "tsup": "^8.5.1",
    "vitest": "^5.0.2"
  }
}
