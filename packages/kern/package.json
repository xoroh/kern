{
  "name": "@xoroh/kern",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Xoroh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoroh/kern.git",
    "directory": "packages/kern"
  },
  "homepage": "https://kern.xoroh.org",
  "bugs": "https://github.com/xoroh/kern/issues",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "./src/theme.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/theme.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/tokens.ts src/utils/cn.ts --format esm,cjs --dts --dts-resolve --external react --external react-dom --external /^@base-ui\\// --external @xoroh/kern-theme --out-dir dist --clean",
    "test": "vitest run --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "check:publish": "publint && attw --pack --ignore-rules=no-resolution",
    "prepare": "bun run build"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme": "./src/theme.css",
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/cn.d.ts",
        "default": "./dist/utils/cn.js"
      },
      "require": {
        "types": "./dist/utils/cn.d.cts",
        "default": "./dist/utils/cn.cjs"
      }
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@base-ui/react": "^1.0.0",
    "@xoroh/kern-theme": "*"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xoroh/kern-theme": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^28.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  }
}
