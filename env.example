# Kern environment variables
#
# Copy to `.env` and fill in real values:
#
#     cp env.example .env
#
# `env.example` holds documented placeholders only. `.env` holds real
# values. Both files are gitignored — never commit either.

# ── Deployment: apps/site → Cloudflare Workers ───────────────────────────
# Wrangler reads these natively (wrangler.jsonc carries no account_id).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Releases: changesets → npm (CI only; GitHub secret in practice) ──────
NPM_TOKEN=

# ── MCP development ─────────────────────────────────────────────────────
# Absolute path to a kern checkout. When set, `get_component` prefers live
# working-tree source over the snapshots bundled in component-sources.ts.
KERN_REPO_ROOT=
