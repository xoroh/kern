#!/usr/bin/env bash
# Pre-commit: refuse a commit that would ship a stale generated artefact.
#
# WHY
#
# `packages/mcp/src/manifest.ts` is generated by scanning the component
# directories, so any reformatting of a source file -- biome included --
# can silently invalidate it, and the drift is only noticed when a release gate
# runs. That happened twice on one day from two different commits
# (`717c4b6` and `eaab476`), and each time it surfaced as a NO-GO on a publish
# step rather than as a red line at the edit.
#
# It was worse while `packages/mcp/src/component-sources.ts` existed, because
# that file embedded the SOURCE TEXT of every component verbatim -- any
# reformat of any source invalidated it by definition. It was deleted in
# `24f7810` (474KB of generated text nothing read), so that specific hazard is
# gone; the manifest's scan-based dependency remains.
#
# The fix is deliberately cheap: `check:generated` ALREADY runs every generator
# into a temp copy and compares byte-for-byte. It is read-only, safe on a dirty
# worktree, and never writes. The only thing missing was running it at the moment
# the cause is still on screen.
#
# IT DOES NOT AUTO-REGENERATE, on purpose. A pre-commit hook that rewrites your
# worktree as a side effect of committing is a surprise, and on a SHARED tree it
# would silently rewrite another lane's staged work. This hook refuses and tells
# you the command; you decide.
#
# IT ALSO LISTS WHAT IT IS ABOUT TO INCLUDE, and that is the newer half. Commit
# `890b5d1` was a gate commit whose message described only gate work while its
# diff carried 794 lines of site-se's feature work — `families.ts` (195, NEW),
# `component-gallery.tsx` (236, NEW), 363 modified lines in
# `routes/components/*`. Neither the message nor the report mentioned them; the
# report even called them "not mine; not touched" while its own commit created
# them. Nothing was wrong with the WORK. What was wrong is that the commit's own
# claim contradicted its own diff, which is the kind of history an auditor reads
# as deception.
#
# So `check-commit-intent` prints "N paths staged, M unexpected" and, when you
# declare scope via KERN_COMMIT_INTENT, REFUSES anything outside it, naming each
# path and its CODEOWNERS owner. Without the env var it still prints the full
# list and flags multi-owner commits — it cannot judge intent it was never told,
# and a hook that refuses every commit gets uninstalled.
#
#   git commit                      # lists everything, refuses nothing
#   KERN_COMMIT_INTENT="scripts/**" git commit   # refuses anything else
#
# Installed by `bun run hooks:install`. See CONTRIBUTING.md.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Skip during rebase/merge/cherry-pick, where the worktree is not the author's
# to modify and a refusal would strand the operation.
for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  if [ -e ".git/$state" ]; then
    exit 0
  fi
done

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found; skipping the generated-output check." >&2
  exit 0
fi

# 1. What is this commit about to include? Runs FIRST, before the expensive
#    generated-output check, so a commit that is going to be refused for
#    swallowing another lane's work says so in under a second rather than after
#    a full generator sweep.
if ! node scripts/check-commit-intent.mjs; then
  echo >&2
  echo "pre-commit REFUSED: staged content outside the declared intent." >&2
  exit 1
fi

if ! bun run check:generated; then
  cat >&2 <<'EOF'

pre-commit REFUSED: a generated artefact is stale.

  A source file changed but the artefacts generated from it did not. The usual
  cause is a formatter reformatting a source that a generator scans or embeds --
  see packages/mcp/src/manifest.ts.

  Fix:   bun run generate:tokens && bun run generate:tones && \
         bun run generate:motion && bun run generate:components
  Then:  git add the regenerated files and commit again.

  To see what is stale:  bun run check:generated

EOF
  exit 1
fi

exit 0