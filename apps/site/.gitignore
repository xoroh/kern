# Generated by `tsr generate` (bun run generate:routes).
# Tracked previously; running the generator rewrote it on every typecheck,
# which dirtied the tree for a file nobody hand-edits.
src/routeTree.gen.ts
# Per-page markdown emission (bun run generate → scripts/generate-page-md.mjs).
# Build output, regenerated on every build: committing it would put 200 files
# under the root generated-artifacts census, whose registry this lane does not
# own. check-page-md owns the emission contract instead.
public/md/
# MCP corpus index (bun run generate → scripts/generate-mcp-index.mjs).
# Same arrangement as public/md/: gitignored build output, served with the
# deployed site at /mcp/index.json. check-mcp-index owns the index contract.
public/mcp/
