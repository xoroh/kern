# Tooling
TODO.md
*.tsbuildinfo

# Assets cache (synced icon sources)
packages/kern-icons/assets/material/

# e2e (qa) — Playwright run artefacts. Regenerated on every run; the only thing
# worth committing is the spec source under e2e/, never a trace or a failure
# screenshot.
test-results/
playwright-report/
blob-report/

# Org/agent scratch — never commit. Canonical registry lives outside the repo;
# kern/.team/ holds restored task artifacts (see its README), worktrees/polly/
# caches are per-run throwaway.
.team/
# M3 full archive — durable local reference (~5GB: spec mirror, illustrations,
# code clones, docs mirrors). Stays on disk, never committed. Curated output
# for Kern lives in docs/design-systems/m3-usable/ instead.
docs/design-systems/m3-archive/
.polly/
.worktrees/
**/.tanstack/

# Lane scratch reports, screenshots and notes (never in git)
.reports/
